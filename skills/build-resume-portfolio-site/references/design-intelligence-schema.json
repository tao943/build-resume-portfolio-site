{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-site-agent.local/schemas/design-intelligence-v2.json",
  "title": "Portfolio design intelligence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "query", "candidate_directions", "script_recommended_direction_id", "selection_owner", "guardrails", "react_guidelines", "provenance"],
  "properties": {
    "schema_version": {"const": 2},
    "mode": {"enum": ["recommend", "enrich"]},
    "generation_id": {"type": "string"},
    "query": {"type": "object"},
    "structure_catalog": {"type": "object"},
    "feasibility": {"type": "object"},
    "baseline": {"type": "object"},
    "anti_template_baseline": {"type": "object"},
    "anti_template_resolution_required": {"const": true},
    "approved_site_design_spec": {"type": "object"},
    "candidate_directions": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/direction"}},
    "pairwise_comparisons": {"type": "array", "items": {"type": "object"}},
    "script_recommended_direction_id": {"type": "string", "minLength": 1},
    "selection_owner": {"const": "agent-via-creative-direction"},
    "guardrails": {"type": "array", "items": {"type": "string"}},
    "react_guidelines": {"type": "array", "items": {"type": "string"}},
    "reference_evidence_priority": {"type": "boolean"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["upstream", "catalog_version", "domains"],
      "properties": {
        "upstream": {"const": "nextlevelbuilder/ui-ux-pro-max-skill"},
        "catalog_version": {"type": "string"},
        "domains": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "direction": {
      "type": "object",
      "required": ["id", "name", "origin", "structure_seed_id", "style_family", "composition", "topology", "first_viewport", "visual_protagonist", "energy_curve", "color_relationships", "typography_roles", "surface_language", "media_strategy", "fit_reasons", "risks", "blocking_floors", "history_distance", "motion_slots", "invariants", "responsive_transformations", "anti_degeneracy_rules", "cost", "source_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "name": {"type": "string"},
        "origin": {"enum": ["fit", "novelty", "wildcard", "reference"]},
        "structure_seed_id": {"type": ["string", "null"]}, "style_family": {"type": "string"},
        "composition": {"type": "string"}, "topology": {"type": "object"},
        "first_viewport": {"type": "object"}, "visual_protagonist": {"type": "string"},
        "energy_curve": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "color_relationships": {"type": "array", "items": {"type": "string"}},
        "typography_roles": {"type": "object"}, "surface_language": {"type": "string"},
        "media_strategy": {"type": "string"}, "fit_reasons": {"type": "array", "items": {"type": "string"}},
        "risks": {"type": "array", "items": {"type": "string"}}, "blocking_floors": {"type": "object"},
        "history_distance": {"type": "number", "minimum": 0, "maximum": 1},
        "nearest_seed_distance": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "motion_slots": {"type": "array"}, "invariants": {"type": "array", "items": {"type": "string"}},
        "responsive_transformations": {"type": "array", "items": {"type": "string"}},
        "anti_degeneracy_rules": {"type": "array", "items": {"type": "string"}},
        "cost": {"type": "object"}, "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
