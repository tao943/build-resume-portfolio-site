{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio multi-agent implementation plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "strategy",
    "integration_owner",
    "shared_files",
    "waves",
    "tasks"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "strategy": {
      "enum": ["fresh-agent-sequential", "parallel-wave"]
    },
    "integration_owner": {"const": "main-agent"},
    "shared_files": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "waves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mode", "task_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "mode": {"enum": ["sequential", "parallel"]},
          "task_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "mode",
          "depends_on",
          "allowed_files",
          "acceptance",
          "verification"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {
            "enum": ["implementation", "review", "integration", "audit"]
          },
          "mode": {"enum": ["write", "read-only"]},
          "depends_on": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "allowed_files": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
