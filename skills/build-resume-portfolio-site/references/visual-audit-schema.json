{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio screenshot-backed visual audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "design_contract", "repair_round", "captures", "deterministic_checks", "dimension_reviews", "findings", "interaction_states_checked", "overall_status"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "candidate_id": {"$ref": "#/$defs/string"},
    "design_contract": {"$ref": "#/$defs/string"},
    "repair_round": {"type": "integer", "minimum": 0, "maximum": 2},
    "captures": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/capture"}},
    "deterministic_checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "dimension_reviews": {
      "type": "object", "additionalProperties": false,
      "required": ["identity_fit", "aesthetic_quality"],
      "properties": {
        "identity_fit": {"$ref": "#/$defs/review"},
        "aesthetic_quality": {"$ref": "#/$defs/review"}
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "interaction_states_checked": {"type": "array", "items": {"$ref": "#/$defs/interaction"}},
    "overall_status": {"$ref": "#/$defs/status"},
    "structure_review": {
      "type": "object", "additionalProperties": false,
      "required": ["seed_identity", "visual_protagonist", "mobile_transformation", "static_without_motion", "novelty_not_palette_only", "evidence_refs", "contract_paths"],
      "properties": {
        "seed_identity": {"const": "pass"}, "visual_protagonist": {"const": "pass"},
        "mobile_transformation": {"const": "pass"}, "static_without_motion": {"const": "pass"},
        "novelty_not_palette_only": {"const": "pass"},
        "evidence_refs": {"$ref": "#/$defs/stringList"}, "contract_paths": {"$ref": "#/$defs/stringList"}
      }
    }
  },
  "allOf": [{"if": {"properties": {"schema_version": {"const": 2}}}, "then": {"required": ["structure_review"]}}],
  "$defs": {
    "string": {"type": "string", "minLength": 1},
    "stringList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/string"}},
    "status": {"enum": ["pass", "repairable", "blocking"]},
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "viewport", "state", "path"],
      "properties": {"id": {"$ref": "#/$defs/string"}, "viewport": {"$ref": "#/$defs/string"}, "state": {"$ref": "#/$defs/string"}, "path": {"$ref": "#/$defs/string"}}
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "status", "evidence_refs", "contract_path", "note"],
      "properties": {"rule_id": {"$ref": "#/$defs/string"}, "status": {"$ref": "#/$defs/status"}, "evidence_refs": {"$ref": "#/$defs/stringList"}, "contract_path": {"$ref": "#/$defs/string"}, "note": {"$ref": "#/$defs/string"}}
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "verdict", "strengths", "evidence_refs", "contract_paths"],
      "properties": {"status": {"$ref": "#/$defs/status"}, "verdict": {"$ref": "#/$defs/string"}, "strengths": {"$ref": "#/$defs/stringList"}, "evidence_refs": {"$ref": "#/$defs/stringList"}, "contract_paths": {"$ref": "#/$defs/stringList"}}
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "rule_id", "dimension", "severity", "viewport_or_state", "region", "evidence_refs", "contract_path", "permitted_files", "proposed_local_change", "intended_result"],
      "properties": {
        "id": {"$ref": "#/$defs/string"}, "rule_id": {"$ref": "#/$defs/string"},
        "dimension": {"enum": ["identity_fit", "aesthetic_quality", "accessibility", "responsive", "runtime_safety"]},
        "severity": {"enum": ["advisory", "repairable", "blocking"]},
        "viewport_or_state": {"$ref": "#/$defs/string"}, "region": {"$ref": "#/$defs/string"},
        "evidence_refs": {"$ref": "#/$defs/stringList"}, "contract_path": {"$ref": "#/$defs/string"},
        "permitted_files": {"$ref": "#/$defs/stringList"}, "proposed_local_change": {"$ref": "#/$defs/string"},
        "intended_result": {"$ref": "#/$defs/string"}
      }
    },
    "interaction": {
      "type": "object", "additionalProperties": false,
      "required": ["controller_family", "target", "trigger", "capture_refs", "coarse_pointer", "reduced_motion", "status"],
      "properties": {"controller_family": {"$ref": "#/$defs/string"}, "target": {"$ref": "#/$defs/string"}, "trigger": {"$ref": "#/$defs/string"}, "capture_refs": {"$ref": "#/$defs/stringList"}, "coarse_pointer": {"$ref": "#/$defs/string"}, "reduced_motion": {"$ref": "#/$defs/string"}, "status": {"$ref": "#/$defs/status"}}
    }
  }
}
